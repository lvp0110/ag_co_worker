NODE_ENV=development
PORT=3007
# Список origin'ов через запятую. Vite по умолчанию на 5175,
# но автоинкрементит до 5176+, если порт занят — поэтому указываем сразу оба.
CORS_ORIGIN=http://localhost:5175,http://localhost:5176
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/ag_co_worker?schema=public
CALC_SERVICE_URL=https://dev3.constrtodo.ru:3005
# /api/v2/data и AllIsolationConstr на dev3 часто >15s — не ставьте 15000
CALC_SERVICE_TIMEOUT_MS=60000
# Внешний auth: POST /login, GET /auth/session, POST /auth/logout
AUTH_SERVICE_URL=http://localhost:3005
# Выгрузка КП в 1С: POST/PUT /integration/onec/isolation/document.
# По умолчанию берётся AUTH_SERVICE_URL — ручка авторизует той же session-cookie.
ONEC_SERVICE_URL=http://localhost:3005
ONEC_TIMEOUT_MS=60000
# ONEC_EXPORT_ENABLED=false — полностью отключить выгрузку
ONEC_EXPORT_ENABLED=true
# Реквизиты организации в шапке/колонтитулах КП и PDF (раньше — таблица companies).
# Отдел сотрудника берётся из department_id внешней сессии; реквизитов auth не отдаёт.
KP_COMPANY_NAME=ООО «Шуманет Шоп»
KP_COMPANY_ADDRESS=115054, Москва г, Новокузнецкая ул, дом 33, строение 2
KP_COMPANY_PHONE=
KP_COMPANY_OGRN=1177746342157
KP_COMPANY_OGRNIP=
KP_COMPANY_KPP=770501001
KP_COMPANY_INN=9705093593
# Путь к файлу логотипа для PDF (PNG/JPEG/WebP). Пусто — без картинки.
# KP_COMPANY_LOGO_FILE=
