NODE_ENV=development
PORT=3007
# Список origin'ов через запятую. Vite по умолчанию на 5175,
# но автоинкрементит до 5176+, если порт занят — поэтому указываем сразу оба.
CORS_ORIGIN=http://localhost:5175,http://localhost:5176
# Локально auth/1С обычно localhost:3005.
# Calc: локальный :3005 может не знать AG.C501_ul / AG.Ct_eco / AG.Cs_mat —
# тогда укажите https://dev3.constrtodo.ru:3005
CALC_SERVICE_URL=http://localhost:3005
# /api/v2/data и AllIsolationConstr часто >15s — не ставьте 15000
CALC_SERVICE_TIMEOUT_MS=60000
# Внешний auth: POST /login, GET /auth/session, POST /auth/logout
AUTH_SERVICE_URL=http://localhost:3005
# Выгрузка КП в 1С: POST/PUT /integration/onec/isolation/document.
# По умолчанию берётся AUTH_SERVICE_URL — ручка авторизует той же session-cookie.
ONEC_SERVICE_URL=http://localhost:3005
ONEC_TIMEOUT_MS=60000
# ONEC_EXPORT_ENABLED=false — полностью отключить выгрузку
ONEC_EXPORT_ENABLED=true
