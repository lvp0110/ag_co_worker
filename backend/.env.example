NODE_ENV=development
PORT=3007
# Список origin'ов через запятую. Vite по умолчанию на 5175,
# но автоинкрементит до 5176+, если порт занят — поэтому указываем сразу оба.
CORS_ORIGIN=http://localhost:5175,http://localhost:5176
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/ag_co_worker?schema=public
JWT_ACCESS_SECRET=replace_with_secure_access_secret
JWT_REFRESH_SECRET=replace_with_secure_refresh_secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
CALC_SERVICE_URL=https://dev3.constrtodo.ru:3005
# /api/v2/data и AllIsolationConstr на dev3 часто >15s — не ставьте 15000
CALC_SERVICE_TIMEOUT_MS=60000
# Внешний auth: POST /login, GET /auth/session, POST /auth/logout
AUTH_SERVICE_URL=http://localhost:3005
