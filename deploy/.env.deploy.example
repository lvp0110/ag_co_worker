# ─── ag_co_worker deploy config ─────────────────────────────────────────────
# Копируется в deploy/.env.deploy (gitignored) на локальной машине оператора.
# Читается скриптами deploy/*.sh перед ssh. В CI генерируется из GitHub Secrets.

# SSH-цель (формат user@host или алиас из ~/.ssh/config).
# webtest: локально есть алиасы test_server / dev3 → 51.250.51.86.
DEPLOY_HOST=leonidl@51.250.51.86

# Абсолютный путь до checkout'а репо на сервере.
# bootstrap.sh создаёт его при первом запуске.
# На webtest проекты живут в /home/leonidl/<project> (как у соседей:
# constr-todo-web, hr-todo-web, ag_sound_calc, acoustic_calc).
DEPLOY_DIR=/home/leonidl/ag_co_worker

# Публичный домен: curl-smoke после деплоя + подстановка в server_name nginx.
DEPLOY_DOMAIN=isocalc.constrtodo.ru

# Абсолютный путь к директории с fullchain.pem / privkey.pem.
# На webtest — общий wildcard-серт *.constrtodo.ru (GlobalSign, до 2026-12-07),
# тот же, что используют acoustic-calc / partners / content.
# Certbot тут НЕ нужен.
DEPLOY_CERT_DIR=/home/leonidl/certs

# Явный приватный SSH-ключ. Нужен, если у DEPLOY_HOST нет IdentityFile в
# ~/.ssh/config (случай webtest: алиасы test_server/dev3 без IdentityFile,
# а дефолтные ключи машина не принимает).
# В CI НЕ задавать — там ключ пишется из секрета в ~/.ssh/id_ed25519.
# DEPLOY_SSH_KEY_FILE=~/.ssh/isocalc_deploy

# Git-remote и ревизия на сервере. deploy-*.sh делают
# `git fetch && git checkout $DEPLOY_REV` перед пересборкой контейнеров.
DEPLOY_REMOTE=origin
DEPLOY_REV=origin/main
