# ─── ag_co_worker production env ────────────────────────────────────────────
# Положить как /srv/ag_co_worker/.env.prod (рядом с docker-compose.prod.yml).
# Права 0600, владелец — пользователь, от которого крутится docker compose.
# НЕ коммитить.

NODE_ENV=production
PORT=3007

# В проде frontend проксирует /api (same-origin), CORS де-факто не срабатывает.
# Значение нужно как страховка на случай прямого стука на API и в логах — подставьте реальный домен.
CORS_ORIGIN=https://ag.example.com

# ─── Postgres ────────────────────────────────────────────────────────────────
# hostname = имя сервиса в docker-compose.prod.yml (postgres).
DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_PASSWORD@postgres:5432/ag_co_worker?schema=public
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ─── External calc service ───────────────────────────────────────────────────
CALC_SERVICE_URL=https://dev3.constrtodo.ru:3005
CALC_SERVICE_TIMEOUT_MS=60000

# ─── External auth (POST /login, GET /auth/session, POST /auth/logout) ────────
AUTH_SERVICE_URL=http://host.docker.internal:3005

# ─── Выгрузка КП в 1С (POST/PUT /integration/onec/isolation/document) ─────────
# Авторизация — та же session-cookie, что у auth, поэтому по умолчанию
# наследуется AUTH_SERVICE_URL. ONEC_EXPORT_ENABLED=false отключает выгрузку.
ONEC_SERVICE_URL=http://host.docker.internal:3005
ONEC_TIMEOUT_MS=60000
ONEC_EXPORT_ENABLED=true

# ─── Админ-доступ ────────────────────────────────────────────────────────────
# Отдельных кредов у приложения нет: роль администратора приходит из внешнего
# auth-сервиса (`role_type: "admin"` в GET /auth/session). Заводить админа нужно
# там же, а не здесь.
