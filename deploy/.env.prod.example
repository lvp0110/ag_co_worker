# ─── ag_co_worker production env ────────────────────────────────────────────
# Положить как $DEPLOY_DIR/.env.prod (рядом с docker-compose.prod.yml).
# Права 0600. НЕ коммитить.
# Читается ОБОИМИ сервисами через env_file в docker-compose.prod.yml.

NODE_ENV=production

# Порт backend ВНУТРИ контейнера. Наружу не публикуется — frontend ходит на
# backend:3006 по compose-сети, поэтому занятый на хосте 3006 (cad-api) не мешает.
# Для frontend этот PORT перебивается в compose (environment > env_file).
PORT=3006

# HOST не задавать! Пустой HOST → bind на 0.0.0.0 внутри контейнера.
# С HOST=127.0.0.1 backend станет недоступен для frontend-контейнера.

# В проде frontend проксирует /api same-origin, так что CORS де-факто не
# срабатывает — но держим корректное значение на случай прямых запросов.
CORS_ORIGIN=https://isocalc.constrtodo.ru

# ─── Внешние сервисы: auth / calc / 1С ───────────────────────────────────────
# ВАЖНО: на webtest (51.250.51.86) НЕЛЬЗЯ писать 127.0.0.1:3005 —
#   1) внутри контейнера 127.0.0.1 это сам контейнер;
#   2) на хосте :3005 занят контейнером hr-todo-web, а не нашим auth-сервисом.
# Реальный auth/calc/1С — dev3.constrtodo.ru:3005 (51.250.51.122).

CALC_SERVICE_URL=https://dev3.constrtodo.ru:3005
CALC_SERVICE_TIMEOUT_MS=60000

# Внешний auth: POST /login, GET /auth/session, POST /auth/logout.
# Этот же URL читает frontend-контейнер — server.js проксирует /login и /auth/*.
AUTH_SERVICE_URL=https://dev3.constrtodo.ru:3005

# Выгрузка КП в 1С (POST/PUT /integration/onec/isolation/document)
ONEC_SERVICE_URL=https://dev3.constrtodo.ru:3005
ONEC_TIMEOUT_MS=60000
ONEC_EXPORT_ENABLED=true
