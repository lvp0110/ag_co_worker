# ─── ag_co_worker production env ────────────────────────────────────────────
# Положить как $DEPLOY_DIR/.env.prod (рядом с docker-compose.prod.yml).
# Права 0600. НЕ коммитить.
# Читается единственным сервисом стека (frontend) через env_file.

NODE_ENV=production

# PORT внутри контейнера задаётся в docker-compose.prod.yml (3008) и
# перебивает значение отсюда — environment приоритетнее env_file.

# HOST не задавать! Пустой HOST → bind на 0.0.0.0 внутри контейнера.
# С HOST=127.0.0.1 контейнер станет недоступен для хостового nginx.

# ─── Upstream: ConstrTodo (auth / calc / админ-API / 1С) ─────────────────────
# server.js проксирует туда /login, /auth/*, /api/*, /integration/*,
# /admin/* (API), /content/*, /commerce/*.
#
# ВАЖНО: на webtest (51.250.51.86) НЕЛЬЗЯ писать 127.0.0.1:3005 —
#   1) внутри контейнера 127.0.0.1 это сам контейнер;
#   2) на хосте :3005 занят контейнером hr-todo-web, а не ConstrTodo.
# Реальный ConstrTodo — dev3.constrtodo.ru:3005 (51.250.51.122).
UPSTREAM_URL=https://dev3.constrtodo.ru:3005

# Историческое имя той же переменной. server.js читает оба, приоритет —
# у UPSTREAM_URL. На работающем сервере в .env.prod лежит именно AUTH_SERVICE_URL,
# поэтому строку можно не трогать при обновлении.
# AUTH_SERVICE_URL=https://dev3.constrtodo.ru:3005

# Origin'ы сборки на GitHub Pages, которым прокси отдаёт CORS-заголовки и для
# которых логин уходит в upstream как не-браузерный (X-Client-Type: plugin).
# Значение по умолчанию — https://lvp0110.github.io.
# PAGES_CORS_ORIGINS=https://lvp0110.github.io
