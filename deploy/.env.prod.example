# ─── ag_co_worker production env ────────────────────────────────────────────
# Положить как /srv/ag_co_worker/.env.prod (корень checkout на сервере).
# Права 0600, владелец — пользователь systemd (deploy). НЕ коммитить.
# Читается единственным сервисом стека через EnvironmentFile в unit-файле.

NODE_ENV=production

# PORT и DIST_DIR задаёт unit (deploy/systemd/ag-co-worker-frontend.service),
# здесь их указывать не нужно.

# ─── Внешний API: auth + calc + админка + 1С (сервис ConstrTodo) ────────────
# Своего backend у проекта нет: frontend/server.js проксирует туда
# /login, /auth/*, /api/*, /integration/*, /content/*, /commerce/* и /admin/*.

UPSTREAM_URL=https://dev3.constrtodo.ru:3005

# Историческое имя той же переменной. server.js читает UPSTREAM_URL, а при его
# отсутствии — AUTH_SERVICE_URL, поэтому старый .env.prod продолжает работать.
# AUTH_SERVICE_URL=https://dev3.constrtodo.ru:3005
