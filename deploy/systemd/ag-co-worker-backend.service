[Unit]
Description=ag_co_worker backend (Express API)
After=network.target

[Service]
Type=simple
WorkingDirectory=/srv/ag_co_worker/backend
EnvironmentFile=/srv/ag_co_worker/.env.prod
# Слушаем loopback — снаружи только через host nginx → frontend.
Environment=HOST=127.0.0.1
ExecStart=/usr/bin/node dist/index.js
Restart=on-failure
RestartSec=3
User=deploy
Group=deploy

# Hardening (мягкий)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
