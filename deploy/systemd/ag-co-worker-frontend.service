[Unit]
Description=ag_co_worker frontend (static + proxy to ConstrTodo)
After=network.target

[Service]
Type=simple
WorkingDirectory=/srv/ag_co_worker/frontend
EnvironmentFile=-/srv/ag_co_worker/.env.prod
Environment=NODE_ENV=production
Environment=PORT=3008
Environment=DIST_DIR=/srv/ag_co_worker/frontend/dist
# UPSTREAM_URL (или историческое AUTH_SERVICE_URL) берётся из .env.prod.
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=3
User=deploy
Group=deploy

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
